# Supabase project + service-role key enable the hosted store (server-side only).
# Leave both blank to use the local data/meals.json file store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required to enable owner publishing once a hosted DB is configured.
# Without these, writes fail closed with a 503. The anon key is public by design
# (sent to the browser); OWNER_EMAIL is the single account allowed to publish.
SUPABASE_ANON_KEY=
OWNER_EMAIL=
